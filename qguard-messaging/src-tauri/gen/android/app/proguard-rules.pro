# Add project specific ProGuard rules here.
# You can control the set of applied configuration files using the
# proguardFiles setting in build.gradle.
#
# For more details, see
#   http://developer.android.com/guide/developing/tools/proguard.html

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Keep line numbers in release stack traces so a native/Java crash reported from
# a user's device maps back to real source lines (the .so is symbol-stripped).
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# ---------------------------------------------------------------------------
# QGuard: classes/members reached BY NAME from native (JNI) code.
#
# The release build sets isMinifyEnabled = true, so R8 renames or strips any
# Java/Kotlin symbol it cannot see a Java/Kotlin caller for. The Rust core loads
# `com.qguard.messaging.PlayBilling` through the app class loader and calls its
# plain-Kotlin static methods (getStateJson / refreshPurchases / launchPurchase)
# by STRING NAME over JNI — see src-tauri/src/commands/billing.rs. If R8 renames
# those methods the call throws NoSuchMethodError at runtime and the paywall
# purchase/restore flow crashes. The autogenerated proguard-wry.pro only keeps
# `native <methods>`, which does NOT cover these, so keep the whole bridge class.
-keep class com.qguard.messaging.PlayBilling { *; }

# Same contract for the Quantum Vault's Storage Access Framework folder picker:
# src-tauri/src/security/saf_folder.rs loads `com.qguard.messaging.VaultFolderPicker`
# through the app class loader and calls launch / getStateJson / reset /
# createDocument / deleteDocument / describeTree by STRING NAME. Renamed or
# stripped, choosing a destination folder would fail only in release builds.
-keep class com.qguard.messaging.VaultFolderPicker { *; }

# Tauri plugin classes are constructed/invoked reflectively by the Tauri plugin
# manager (getPluginManager); keep them so a release build can't strip a plugin
# the app loads at runtime (shell/dialog, and future plugins).
-keep class app.tauri.** { *; }
-dontwarn app.tauri.**

# Google Play Billing Library (defensive; the AAR ships consumer rules too).
-keep class com.android.billingclient.api.** { *; }
-dontwarn com.android.billingclient.**