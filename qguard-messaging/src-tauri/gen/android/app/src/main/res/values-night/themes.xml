<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- QGuard Messaging dark theme: slate canvas, purple gradient accents. -->
    <style name="Theme.qguard_messaging" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/qguard_violet_500</item>
        <item name="colorPrimaryVariant">@color/qguard_violet_600</item>
        <item name="colorSecondary">@color/qguard_cyan_500</item>
        <item name="android:windowBackground">@color/qguard_canvas_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/qguard_brand_navy</item>
    </style>
</resources>
