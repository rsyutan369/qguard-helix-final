{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QGuard Messaging",
  "version": "1.2.29",
  "identifier": "com.qguard.messaging",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "QGuard Messaging",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.qguard.dev; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; script-src 'self'",
      "dangerousDisableAssetCspModification": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyQzM3NkNFMDIyRkYxNjQKUldSazhTOEN6bmJEb21uaXdTMGRhenBVSy9lQjlENHRNc2M5TlN4Q1NGQmdjVG5PZDNsTVM3cVkK",
      "endpoints": [
        "https://api.qguard.dev/downloads/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "publisher": "QGuard Helix",
    "category": "Productivity",
    "shortDescription": "Quantum-secure messaging and file vault",
    "longDescription": "Post-quantum end-to-end encrypted messaging (Secure Chat) and a strictly on-device encrypted file vault (Quantum Vault), built on NIST-standardized cryptography (FIPS 203 & 204).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "android": {
      "minSdkVersion": 29
    }
  }
}
