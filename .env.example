# =============================================================================
# QGuard Helix — environment variable reference (NAMES ONLY, never values)
# =============================================================================
# Copy to `.env` for local development (`npm run dev`). `.env*` files are
# gitignored; this template is the only tracked one and must never contain a
# real key. Full classification: docs/deployment/02-ENVIRONMENT.md
#
# Where each group lives in production:
#   [FRONTEND]  Vercel project env (build-time, PUBLIC — inlined into the JS bundle)
#   [API]       Kubernetes: ConfigMap qguard-api-config / Secret qguard-api-secrets
#   [EDGE]      Supabase Edge Function secrets (`supabase secrets set`)

# --- [FRONTEND] + [API] Supabase project (required) --------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- [API] Supabase service role (required, SECRET, server-only) --------------
SUPABASE_SERVICE_ROLE_KEY=

# --- [FRONTEND] optional -------------------------------------------------------
# Split-origin API: set to https://api.qguardhelix.com on Vercel so the SPA calls
# the API directly (src/lib/api-origin.ts). Leave unset locally.
# VITE_API_ORIGIN=
# Public origin embedded in report verification QR codes.
# VITE_REPORT_VERIFICATION_ORIGIN=https://qguardhelix.com
# Non-Supabase billing host (default: the Supabase `billing` Edge Function).
# VITE_BILLING_API_ORIGIN=

# --- [API] origins (required in production) ------------------------------------
# APP_ORIGIN=https://qguardhelix.com
# PUBLIC_APP_URL=https://qguardhelix.com
# ALLOWED_ORIGINS=https://qguardhelix.com,https://www.qguardhelix.com
# QGUARD_CONTROL_PLANE_URL=https://api.qguardhelix.com
# QGUARD_ENVIRONMENT=production

# --- [API] payments (SECRET) -----------------------------------------------------
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET_KEY=
# PAYPAL_ENV=live
# PAYPAL_WEBHOOK_ID=
# PAYPAL_RECONCILE_SECRET=
# PAYPAL_PLAN_STARTER_MONTHLY= / _YEARLY, PAYPAL_PLAN_BASIC_*, PAYPAL_PLAN_PRO_*, PAYPAL_PLAN_ELITE_*

# --- [API] behaviour toggles -----------------------------------------------------
# Server-side registration auto-confirm (POST /api/v1/auth/register). Unset = ON
# in development, OFF in production. Keep it OFF in production and configure
# custom SMTP in Supabase Auth so real confirmation emails are sent.
# REGISTRATION_AUTO_CONFIRM=
# Header set by a trusted proxy with the real client IP (production behind
# Cloudflare with the origin locked to Cloudflare ranges): cf-connecting-ip
# TRUSTED_CLIENT_IP_HEADER=

# --- Supabase fallback project (development only; NEVER in production) ------------
# The production preflight refuses to start when any of these are set.
# VITE_SUPABASE_FALLBACK_URL=
# VITE_SUPABASE_FALLBACK_ANON_KEY=
# SUPABASE_FALLBACK_SERVICE_ROLE_KEY=
# VITE_SUPABASE_USE_FALLBACK=false
# SUPABASE_USE_FALLBACK=false
