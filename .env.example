# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase fallback project. Used when the primary project is missing/failing,
# or immediately when VITE_SUPABASE_USE_FALLBACK / SUPABASE_USE_FALLBACK is true.
VITE_SUPABASE_FALLBACK_URL="https://hiesgnkacagduetkudlb.supabase.co"
VITE_SUPABASE_FALLBACK_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhpZXNnbmthY2FnZHVldGt1ZGxiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA2NTA4NjUsImV4cCI6MjA5NjIyNjg2NX0.BPrRtAzVPpdu8lNd7yV019qbffgY0MMHU-MxwO0HbdI"
SUPABASE_FALLBACK_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhpZXNnbmthY2FnZHVldGt1ZGxiIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MDY1MDg2NSwiZXhwIjoyMDk2MjI2ODY1fQ.1LPBmtdMLzXwT1E9bsHc-ztlr_ZZG5Dhp5T2-49ZdMg"

# Set these to true to route new logins, registrations, storage, and database
# calls directly to the fallback Supabase project.
VITE_SUPABASE_USE_FALLBACK="false"
SUPABASE_USE_FALLBACK="false"

# Public origin used in report verification URLs/QR codes (Executive Certification Summary).
# Set to your production domain so exported reports never carry a development host.
VITE_REPORT_VERIFICATION_ORIGIN=https://qguardhelix.com

# Server-side registration auto-confirm (POST /api/v1/auth/register). When true,
# accounts are created pre-verified WITHOUT sending a confirmation email — this
# avoids Supabase's ~2/hour built-in mailer quota but does NOT prove inbox
# ownership. Unset defaults to ON in development and OFF in production. Keep OFF
# and configure custom SMTP (Supabase Auth → SMTP) for production so real
# confirmation emails are sent; when off, the client uses the standard signup
# flow. Privileged (owner/admin) emails are always refused by this endpoint.
# REGISTRATION_AUTO_CONFIRM=false

# --- Demo / test account (TEMPORARY, development only) ----------------------
# Enables a sign-in that never contacts Supabase, for use when the Supabase
# project is unreachable (quota restriction, outage) and the platform still has
# to be demonstrated or tested. See src/lib/demo-account.ts and
# tasks/demo-account.md.
#
#   email    demo@qguard-helix.test
#   password QguardDemo!2026
#   tier     elite (every subscription-gated module; NOT platform owner)
#
# OFF unless explicitly set to "true". Never set this in production: it is a
# password-equivalent that grants Elite access with no billing record behind it.
# Verify with: npx tsx tools/demo-account-check.ts
VITE_DEMO_ACCOUNT="false"
