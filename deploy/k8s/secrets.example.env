# Names of the keys in the `qguard-api-secrets` Kubernetes Secret.
# Copy to a file OUTSIDE the repository (e.g. ~/qguard/api.production.env),
# fill in the values, then:
#
#   kubectl -n qguard-production create secret generic qguard-api-secrets \
#     --from-env-file=$HOME/qguard/api.production.env --dry-run=client -o yaml | kubectl apply -f -
#
# Never commit the filled-in file. Staging uses its OWN values (its own
# Supabase project) in the qguard-staging namespace.

# --- Supabase (REQUIRED) -----------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- PayPal (required for in-app subscription management) --------------------
# The PayPal WEBHOOK is received by the Supabase `billing` Edge Function; leave
# PAYPAL_WEBHOOK_ID unset here unless the Express receiver is registered instead.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
PAYPAL_ENV=live
PAYPAL_PLAN_STARTER_MONTHLY=
PAYPAL_PLAN_STARTER_YEARLY=
PAYPAL_PLAN_BASIC_MONTHLY=
PAYPAL_PLAN_BASIC_YEARLY=
PAYPAL_PLAN_PRO_MONTHLY=
PAYPAL_PLAN_PRO_YEARLY=
PAYPAL_PLAN_ELITE_MONTHLY=
PAYPAL_PLAN_ELITE_YEARLY=
# Enables POST /api/v1/paypal/reconcile (and the optional paypal-reconcile CronJob)
PAYPAL_RECONCILE_SECRET=

# --- Request Demo email (landing page → info@qguardhelix.com) ----------------
# Without SMTP_HOST the demo form tells visitors to email the inbox themselves.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=
# DEMO_REQUEST_TO=

# --- Google Play billing (only if Android subscriptions are enabled) ---------
# GOOGLE_PLAY_PACKAGE_NAME=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# PLAY_RTDN_TOKEN=

# --- MUST NOT be set on API pods (the startup preflight refuses them) --------
# GITHUB_TOKEN / GH_TOKEN / GITLAB_TOKEN / BITBUCKET_* / AZURE_DEVOPS_* / GITEA_TOKEN ...
# VITE_SUPABASE_FALLBACK_* / SUPABASE_FALLBACK_SERVICE_ROLE_KEY / SUPABASE_USE_FALLBACK
# REGISTRATION_AUTO_CONFIRM=true
